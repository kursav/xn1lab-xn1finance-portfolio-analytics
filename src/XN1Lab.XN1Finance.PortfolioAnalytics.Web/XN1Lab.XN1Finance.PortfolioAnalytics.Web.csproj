<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <XN1LabPlatformRoot Condition="'$(XN1LabPlatformRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\platform</XN1LabPlatformRoot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Api\XN1Lab.Platform.Api.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Branding\XN1Lab.Platform.Branding.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Core\XN1Lab.Platform.Core.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.CoreServices.Contracts\XN1Lab.Platform.CoreServices.Contracts.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Identity\XN1Lab.Platform.Identity.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Identity.Blazor\XN1Lab.Platform.Identity.Blazor.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Identity.Keycloak\XN1Lab.Platform.Identity.Keycloak.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Localization\XN1Lab.Platform.Localization.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.SaaSHost\XN1Lab.Platform.SaaSHost.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.Shared\XN1Lab.Platform.Shared.csproj" />
    <ProjectReference Include="$(XN1LabPlatformRoot)\XN1Lab.Platform.UI\XN1Lab.Platform.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Localization\*.json" />
  </ItemGroup>

</Project>

